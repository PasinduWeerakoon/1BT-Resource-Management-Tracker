{
  "name": "rm-frontend",
  "version": "1.0.0",
  "description": "Resource Management System Frontend",
  "private": true,
  "scripts": {
    "start": "webpack serve --mode development --open",
    "start:dev": "REACT_APP_ENV=dev webpack serve --mode development --open",
    "start:qa": "REACT_APP_ENV=qa webpack serve --mode development --open",
    "start:prod": "REACT_APP_ENV=prod webpack serve --mode development --open",
    "build": "webpack --mode production",
    "build:dev": "REACT_APP_ENV=dev webpack --mode production",
    "build:qa": "REACT_APP_ENV=qa webpack --mode production",
    "build:prod": "REACT_APP_ENV=prod webpack --mode production",
    "build:dev:watch": "webpack --mode development",
    "analyze": "webpack --mode production --analyze",
    "analyze:dev": "webpack --mode development --analyze"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@reduxjs/toolkit": "^2.0.1",
    "antd": "^5.12.0",
    "axios": "^1.6.2",
    "chart.js": "^4.4.0",
    "dayjs": "^1.11.10",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.1",
    "react-router-dom": "^6.20.0",
    "react-toastify": "^9.1.3",
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@babel/preset-react": "^7.23.4",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^6.8.1",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.3",
    "sass": "^1.69.5",
    "sass-loader": "^13.3.2",
    "style-loader": "^3.3.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
