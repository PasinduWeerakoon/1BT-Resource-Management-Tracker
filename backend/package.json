{
  "name": "1bt-resource-management-backend",
  "version": "2.0.0",
  "description": "AWS Serverless Microservices Backend for 1BT Resource Management System",
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "lint": "eslint shared/**/*.js services/**/*.js",
    "lint:fix": "eslint shared/**/*.js services/**/*.js --fix",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "seed": "node database/scripts/seed.js",
    "deploy": "powershell -File deploy.ps1 -Stage dev -Action deploy",
    "deploy:dev": "powershell -File deploy.ps1 -Stage dev -Action deploy",
    "deploy:qa": "powershell -File deploy.ps1 -Stage qa -Action deploy",
    "deploy:uat": "powershell -File deploy.ps1 -Stage uat -Action deploy",
    "deploy:prod": "powershell -File deploy.ps1 -Stage prod -Action deploy",
    "remove:dev": "powershell -File deploy.ps1 -Stage dev -Action remove",
    "remove:qa": "powershell -File deploy.ps1 -Stage qa -Action remove",
    "remove:uat": "powershell -File deploy.ps1 -Stage uat -Action remove",
    "remove:prod": "powershell -File deploy.ps1 -Stage prod -Action remove",
    "deploy:layer": "cd shared/layers/common-layer && serverless deploy --stage dev",
    "deploy:infra": "cd infrastructure && serverless deploy --stage dev",
    "deploy:auth": "cd services/auth-service && serverless deploy --stage dev",
    "deploy:resource": "cd services/resource-service && serverless deploy --stage dev",
    "deploy:project": "cd services/project-service && serverless deploy --stage dev",
    "deploy:allocation": "cd services/allocation-service && serverless deploy --stage dev",
    "deploy:report": "cd services/report-service && serverless deploy --stage dev",
    "deploy:document": "cd services/document-service && serverless deploy --stage dev"
  },
  "keywords": [
    "aws",
    "lambda",
    "serverless",
    "resource-management"
  ],
  "author": "1BT Tech Team",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.971.0",
    "@aws-sdk/client-rds": "^3.490.0",
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/client-secrets-manager": "^3.490.0",
    "@aws-sdk/client-ssm": "^3.971.0",
    "@middy/core": "^7.0.2",
    "@middy/http-cors": "^7.0.2",
    "@middy/http-error-handler": "^7.0.2",
    "@middy/http-json-body-parser": "^7.0.2",
    "@middy/validator": "^7.0.2",
    "dotenv": "^17.2.3",
    "http-errors": "^2.0.1",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^8.0.4",
    "serverless": "^3.38.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-offline": "^13.3.0",
    "serverless-python-requirements": "^6.1.2"
  }
}