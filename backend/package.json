{
  "name": "1bt-resource-management-backend",
  "version": "1.0.0",
  "description": "AWS Serverless Backend for 1BT Resource Management System",
  "main": "src/handlers/index.js",
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "seed": "node database/scripts/seed.js",
    "local": "serverless offline start --stage dev",
    "deploy:dev": "serverless deploy --stage dev --verbose",
    "deploy:qa": "serverless deploy --stage qa --verbose",
    "deploy:uat": "serverless deploy --stage uat --verbose",
    "deploy:prod": "serverless deploy --stage prod --verbose",
    "remove:dev": "serverless remove --stage dev",
    "remove:qa": "serverless remove --stage qa",
    "remove:uat": "serverless remove --stage uat",
    "remove:prod": "serverless remove --stage prod",
    "logs:dev": "serverless logs -f resourceHandler --stage dev -t",
    "info:dev": "serverless info --stage dev",
    "info:qa": "serverless info --stage qa",
    "info:prod": "serverless info --stage prod"
  },
  "keywords": [
    "aws",
    "lambda",
    "serverless",
    "resource-management"
  ],
  "author": "1BT Tech Team",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.971.0",
    "@aws-sdk/client-rds": "^3.490.0",
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/client-secrets-manager": "^3.490.0",
    "@aws-sdk/client-ssm": "^3.971.0",
    "@middy/core": "^7.0.2",
    "@middy/http-cors": "^7.0.2",
    "@middy/http-error-handler": "^7.0.2",
    "@middy/http-json-body-parser": "^7.0.2",
    "@middy/validator": "^7.0.2",
    "http-errors": "^2.0.1",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "dotenv": "^16.3.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^8.0.4",
    "serverless": "^3.38.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-offline": "^13.3.0"
  }
}
