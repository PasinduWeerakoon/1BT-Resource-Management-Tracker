{
  "name": "1bt-resource-management-backend",
  "version": "2.0.0",
  "description": "AWS Serverless Microservices Backend for 1BT Resource Management System",
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "lint": "eslint shared/**/*.js services/**/*.js",
    "lint:fix": "eslint shared/**/*.js services/**/*.js --fix",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "seed": "node database/scripts/seed.js",
    "deploy": "bash deploy.sh -s dev -a deploy",
    "deploy:dev": "bash deploy.sh -s dev -a deploy",
    "deploy:qa": "bash deploy.sh -s qa -a deploy",
    "deploy:uat": "bash deploy.sh -s uat -a deploy",
    "deploy:prod": "bash deploy.sh -s prod -a deploy",
    "remove:dev": "bash deploy.sh -s dev -a remove",
    "remove:qa": "bash deploy.sh -s qa -a remove",
    "remove:uat": "bash deploy.sh -s uat -a remove",
    "remove:prod": "bash deploy.sh -s prod -a remove",
    "status:dev": "bash deploy.sh -s dev -a status",
    "status:qa": "bash deploy.sh -s qa -a status",
    "status:uat": "bash deploy.sh -s uat -a status",
    "status:prod": "bash deploy.sh -s prod -a status",
    "deploy:layer": "cd shared && npx serverless deploy --stage dev",
    "deploy:infra": "cd infrastructure && npx serverless deploy --stage dev",
    "deploy:auth": "cd services/auth-service && npx serverless deploy --stage dev",
    "deploy:resource": "cd services/resource-service && npx serverless deploy --stage dev",
    "deploy:project": "cd services/project-service && npx serverless deploy --stage dev",
    "deploy:allocation": "cd services/allocation-service && npx serverless deploy --stage dev",
    "deploy:report": "cd services/report-service && npx serverless deploy --stage dev",
    "deploy:document": "cd services/document-service && npx serverless deploy --stage dev"
  },
  "keywords": [
    "aws",
    "lambda",
    "serverless",
    "resource-management"
  ],
  "author": "1BT Tech Team",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.971.0",
    "@aws-sdk/client-rds": "^3.490.0",
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/client-secrets-manager": "^3.490.0",
    "@aws-sdk/client-ssm": "^3.971.0",
    "@middy/core": "^7.0.2",
    "@middy/http-cors": "^7.0.2",
    "@middy/http-error-handler": "^7.0.2",
    "@middy/http-json-body-parser": "^7.0.2",
    "@middy/validator": "^7.0.2",
    "dotenv": "^17.2.3",
    "http-errors": "^2.0.1",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^8.0.4",
    "serverless": "^4.31.2",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-offline": "^14.4.0",
    "serverless-python-requirements": "^6.1.2"
  }
}