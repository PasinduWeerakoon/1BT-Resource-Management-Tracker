# Environment Configuration Example
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/resource_management
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=resource_management
DATABASE_USER=admin
DATABASE_PASSWORD=your_password_here

# AWS Cognito
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1

# AWS S3
S3_BUCKET_DOCUMENTS=1bt-resource-documents-dev
S3_BUCKET_FRONTEND=1bt-resource-frontend-dev

# Redis (ElastiCache)
REDIS_HOST=localhost
REDIS_PORT=6379

# Application
NODE_ENV=development
LOG_LEVEL=debug
API_VERSION=v1

# Encryption (for PII fields)
ENCRYPTION_KEY=your_32_byte_encryption_key_here
