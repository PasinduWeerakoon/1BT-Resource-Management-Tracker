{
    "name": "onebt-document-service",
    "version": "1.0.0",
    "description": "Document generation microservice - Python for Excel/PDF generation",
    "scripts": {
        "deploy": "serverless deploy",
        "deploy:dev": "serverless deploy --stage dev",
        "deploy:qa": "serverless deploy --stage qa",
        "deploy:uat": "serverless deploy --stage uat",
        "deploy:prod": "serverless deploy --stage prod",
        "remove": "serverless remove",
        "logs": "serverless logs -f",
        "invoke": "serverless invoke -f"
    },
    "devDependencies": {
        "serverless": "^3.38.0",
        "serverless-python-requirements": "^6.0.0"
    }
}