{
    "name": "onebt-allocation-service",
    "version": "1.0.0",
    "description": "Allocation management microservice - handles resource allocations and history",
    "type": "module",
    "scripts": {
        "deploy": "serverless deploy",
        "deploy:dev": "serverless deploy --stage dev",
        "deploy:qa": "serverless deploy --stage qa",
        "deploy:uat": "serverless deploy --stage uat",
        "deploy:prod": "serverless deploy --stage prod",
        "remove": "serverless remove",
        "logs": "serverless logs -f",
        "invoke": "serverless invoke -f"
    },
    "dependencies": {
        "@aws-sdk/client-eventbridge": "^3.986.0"
    },
    "devDependencies": {
        "serverless": "^3.38.0",
        "serverless-offline": "^13.9.0"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
